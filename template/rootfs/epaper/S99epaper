#!/bin/sh
#
# S99epaper    Starts the 2.7inch e-Paper demo.
#
# S99 so it runs last, after udev has created the GPIO and spidev nodes.
# The demo exits by itself within a few seconds if no panel answers, so a
# board with nothing plugged in boots normally.

DAEMON=/usr/bin/epaper-demo
PIDFILE=/var/run/epaper-demo.pid
ARGS=""

[ -x "$DAEMON" ] || exit 0
[ -r /etc/default/epaper ] && . /etc/default/epaper

start() {
	printf "Starting e-Paper demo: "
	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS
	echo "OK"
}

stop() {
	printf "Stopping e-Paper demo: "
	start-stop-daemon -K -q -p "$PIDFILE"
	rm -f "$PIDFILE"
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
