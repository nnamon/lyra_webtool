/dts-v1/;

/ {
	description = "U-Boot FIT source file for arm";
	#address-cells = <1>;

	images {
		fdt {
			data = /incbin/("fdt.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			load = <0xffffff00>;
			hash {
				algo = "sha256";
			};
		};
		kernel {
			data = /incbin/("kernel.bin");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			entry = <0xffffff01>;
			load = <0xffffff01>;
			hash {
				algo = "sha256";
			};
		};
		resource {
			data = /incbin/("resource.bin");
			type = "multi";
			arch = "arm";
			compression = "none";
			hash {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "conf";
		conf {
			rollback-index = <0x0>;
			fdt = "fdt";
			kernel = "kernel";
			multi = "resource";
		};
	};
};
